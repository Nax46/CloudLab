# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster domain with your MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cloudlab?retryWrites=true&w=majority

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
